# ตัวอย่างสำหรับ Docker Compose — คัดลอกเป็นไฟล์ `.env` ที่ root โปรเจกต์
# หรือ: docker compose --env-file .env.docker.example up --build
#
# ก่อนรัน: เปิด Docker Desktop / OrbStack ให้ daemon พร้อม
# ทดสอบ build + up + HTTP (Windows): npm run docker:verify
# บน Mac/Linux: npm run docker:verify:sh  หรือ  bash scripts/docker-verify.sh
#
# รหัส MySQL — entrypoint เข้ารหัสให้อัตโนมัติ (อักขระพิเศษในรหัสใช้ได้)
MYSQL_ROOT_PASSWORD=dev_mysql_password_change_me
MYSQL_DATABASE=mawell_buffet
MYSQL_PORT=3306

APP_PORT=3000
AUTH_SECRET=replace-with-at-least-32-random-characters-here
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ฐานว่างบน Docker: ลำดับไฟล์ migration บางชุดไม่ตรง dependency — ใช้ db push แทน migrate deploy
# (บน production ที่ migrate ใช้ได้แล้ว ให้ตั้งเป็น 0 หรือลบบรรทัดนี้)
PRISMA_DB_PUSH=1

# ถ้าเปิดจากมือถือใน LAN บน Mac mini ให้ใส่ IP เครื่อง เช่น:
# APP_URL=http://192.168.1.50:3000
# NEXT_PUBLIC_APP_URL=http://192.168.1.50:3000

# ตัวแปรอื่น ๆ (Google OAuth, Ollama, …) คัดลอกจาก .env.example มาใส่ใน .env เดียวกันได้

# --- พัฒนาบนเครื่อง + MySQL ใน Docker เท่านั้น (เห็นการแก้โค้ดทันที ไม่ต้อง build image แอป) ---
# 1) ให้มีไฟล์ `.env` ที่ root ตามไฟล์นี้ (อย่างน้อย MYSQL_ROOT_PASSWORD, MYSQL_DATABASE, MYSQL_PORT)
# 2) คัดลอก env.local.docker-db.example เป็น `.env.local` แล้วแก้ DATABASE_URL:
#    - host ต้องเป็น 127.0.0.1 (ไม่ใช้ชื่อโฮสต์ `db` — ใช้ได้แค่ใน container แอป)
#    - พอร์ตต้องตรง MYSQL_PORT (เช่น 3306 หรือ 3307)
#    - user/password ต้องตรง MYSQL_ROOT_PASSWORD
# 3) รันคำสั่งใดคำสั่งหนึ่ง:
#      npm run dev:docker-db
#    หรือ (Windows):
#      npm run dev:docker-db:ps1
#    หรือแยกขั้น:  npm run docker:db   แล้ว   npm run dev
# 4) ฐานใหม่บน Docker: จากเครื่องรัน  npx prisma migrate deploy  (หรือตามที่โปรเจกต์ใช้)
# 5) หยุด MySQL:  docker compose stop db
