# Next.js dev + hot reload — ใช้กับ docker-compose.dev.yml (mount โซร์สจากโฮสต์)
# image นี้เตรียม dependency layer; /app ถูกแทนที่ด้วย bind mount + volume node_modules
FROM node:22-bookworm-slim AS base
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

ENV DATABASE_URL="mysql://root:build@127.0.0.1:3306/placeholder"
COPY package.json package-lock.json ./
COPY prisma ./prisma
COPY prisma.config.ts ./prisma.config.ts
COPY scripts ./scripts
RUN npm ci

COPY docker/dev-entrypoint.sh /dev-entrypoint.sh
RUN sed -i 's/\r$//' /dev-entrypoint.sh && chmod +x /dev-entrypoint.sh

ENTRYPOINT ["/dev-entrypoint.sh"]
CMD ["npm", "run", "dev"]
