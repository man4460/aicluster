# =============================================================================
# MAWELL DB Backup — ตัวแปรเฉพาะของระบบ backup (อย่า commit ไฟล์จริง)
# คัดลอก: cp scripts/backup-db.env.example scripts/backup-db.env
# =============================================================================

# ปลายทาง (เครื่อง 2 — เก็บไฟล์ backup)
BACKUP_REMOTE_HOST=192.168.1.192
BACKUP_REMOTE_USER=mawell
BACKUP_REMOTE_PATH=mawell-backups   # path ใต้ $HOME ของผู้ใช้ปลายทาง
BACKUP_REMOTE_PORT=22
BACKUP_SSH_KEY=$HOME/.ssh/id_ed25519

# จำนวนวันที่เก็บไฟล์เก่า (ลบของเกิน N วัน)
BACKUP_RETENTION_DAYS=30

# ที่อยู่ log (ค่าเริ่ม $HOME/logs/db-backup.log)
# BACKUP_LOG_DIR=$HOME/logs
# BACKUP_LOG_FILE=$HOME/logs/db-backup.log

# ต้นทาง (เครื่อง 4) — ปกติอ่านจาก DATABASE_URL ใน .env ของโปรเจกต์เอง
# ตั้งทับได้ถ้าจำเป็น
# SOURCE_HOST=127.0.0.1
# SOURCE_PORT=3306
# SOURCE_USER=root
# SOURCE_PASSWORD=
# SOURCE_DB=mawell_buffet
