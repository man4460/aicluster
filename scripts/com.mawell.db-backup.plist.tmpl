<?xml version="1.0" encoding="UTF-8"?>
<!--
MAWELL DB Backup — LaunchAgent (macOS)
ติดตั้ง: bash scripts/backup-db-setup.sh install
ลบ:    bash scripts/backup-db-setup.sh uninstall

template ใช้ {{REPO_DIR}}, {{HOME_DIR}} แทนที่ตอน install
-->
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mawell.db-backup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd {{REPO_DIR}} &amp;&amp; bash scripts/backup-db.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>{{HOME_DIR}}/logs/db-backup.launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>{{HOME_DIR}}/logs/db-backup.launchd.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>{{HOME_DIR}}</string>
  </dict>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
