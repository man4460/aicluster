model PromptLibraryPrompt {
  id          String @id @default(cuid())
  ownerUserId String @map("owner_user_id") @db.VarChar(191)
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  categoryId String?                @map("category_id") @db.VarChar(191)
  category   PromptLibraryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  title       String   @db.VarChar(200)
  content     String   @db.Text
  description String?  @db.VarChar(500)
  /** เก็บแบบสตริงคั่นจุลภาค (เข้ากับฟอร์มเดิมจาก Prompt Master) */
  tags        String   @default("") @db.VarChar(512)
