model Asset {
  id                  Int                @id @default(autoincrement())
  ownerUserId         String             @map("owner_id") @db.VarChar(191)
  owner               User               @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  trialSessionId      String             @default("prod") @map("trial_session_id") @db.VarChar(36)
  assetCode           String             @map("asset_code") @db.VarChar(40)
  assetName           String             @map("asset_name") @db.VarChar(200)
  categoryId          Int?               @map("category_id")
  category            AssetCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand               String?            @db.VarChar(120)
  model               String?            @db.VarChar(160)
  serialNumber        String?            @map("serial_number") @db.VarChar(160)
  description         String?            @db.Text
  purchaseDate        DateTime?          @map("purchase_date") @db.Date
  purchasePrice       Decimal?           @map("purchase_price") @db.Decimal(14, 2)
  supplierId          Int?               @map("supplier_id")
  supplier            AssetSupplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
