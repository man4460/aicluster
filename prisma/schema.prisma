  /** พร้อมใช้งาน | ถูกยืม | ชำรุด | สูญหาย | จำหน่าย — ตรงกับ media_system */
  mediaStatus   String   @map("media_status") @db.VarChar(40)
  conditionNow  String?  @map("condition_now") @db.VarChar(80)
  budgetYear    String?  @map("budget_year") @db.VarChar(8)

  locationId String?                @map("location_id") @db.VarChar(191)
  location   MediaRegistryLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  locationDetail       String? @map("location_detail") @db.VarChar(500)
  responsibleTeacher   String? @map("responsible_teacher") @db.VarChar(200)
  note                 String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  borrows MediaRegistryBorrow[]
  issues  MediaRegistryIssue[]

  @@unique([ownerUserId, registerNo], map: "mri_owner_reg_uidx")
  @@index([ownerUserId, category], map: "mri_owner_cat_idx")
  @@index([ownerUserId, mediaStatus], map: "mri_owner_status_idx")
  @@map("media_registry_items")
}

model MediaRegistryBorrow {
  id          String   @id @default(cuid())
  ownerUserId String   @map("owner_user_id") @db.VarChar(191)
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  borrowNo  String   @map("borrow_no") @db.VarChar(64)
  mediaId   String   @map("media_id") @db.VarChar(191)
  media     MediaRegistryItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  mediaName    String  @map("media_name") @db.VarChar(255)
  borrowerName String  @map("borrower_name") @db.VarChar(200)
  borrowerId   String? @map("borrower_id") @db.VarChar(64)
  borrowerType String  @default("ครู") @map("borrower_type") @db.VarChar(40)

  quantityBorrow Int @map("quantity_borrow")
  quantityReturn Int @default(0) @map("quantity_return")

  borrowDate DateTime  @map("borrow_date") @db.Date
  dueDate    DateTime? @map("due_date") @db.Date
  returnDate DateTime? @map("return_date") @db.Date

  purpose          String? @db.VarChar(500)
  conditionBefore  String? @map("condition_before") @db.VarChar(80)
  conditionAfter   String? @map("condition_after") @db.VarChar(80)
  approveBy        String? @map("approve_by") @db.VarChar(120)
  receiverName     String? @map("receiver_name") @db.VarChar(120)

  /** กำลังยืม | คืนบางส่วน | คืนแล้ว | เกินกำหนด */
  borrowStatus String  @map("borrow_status") @db.VarChar(40)
  note         String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([ownerUserId, borrowNo], map: "mrb_owner_borrow_uidx")
  @@index([ownerUserId, borrowStatus], map: "mrb_owner_status_idx")
  @@index([mediaId], map: "mrb_media_idx")
  @@map("media_registry_borrows")
}

model MediaRegistryIssue {
  id          String   @id @default(cuid())
  ownerUserId String   @map("owner_user_id") @db.VarChar(191)
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  mediaId   String   @map("media_id") @db.VarChar(191)
  media     MediaRegistryItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaName String   @map("media_name") @db.VarChar(255)

  /** ชำรุด | ซ่อมบำรุง | สูญหาย | จำหน่าย */
  recordType       String   @map("record_type") @db.VarChar(40)
  quantityAffected Int      @default(1) @map("quantity_affected")
  cost             Decimal  @default(0) @db.Decimal(12, 2)
  detail           String?  @db.Text
  /** ซ่อมบำรุง: เช่น เสร็จสิ้น */
  repairStatus     String?  @map("repair_status") @db.VarChar(40)
  recordDate       DateTime @map("record_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")

  @@index([ownerUserId, recordType], map: "mris_owner_type_idx")
  @@index([mediaId], map: "mris_media_idx")
  @@map("media_registry_issues")
}

// ——— E-Commerce Store Builder (กลุ่ม 1 · 1 โทเคน/วัน) ———

enum EcommerceOrderStatus {
  PENDING_SLIP
  VERIFYING
  PREPARING
  SHIPPED
}

/** ร้านค้าออนไลน์ของ Merchant — ผูก ownerUserId (เจ้าของร้าน) */
model EcommerceStore {
  id                    String   @id @default(cuid())
  ownerUserId           String   @map("owner_id") @db.VarChar(191)
  owner                 User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  trialSessionId        String   @default("prod") @map("trial_session_id") @db.VarChar(36)

  storeName             String   @map("store_name") @db.VarChar(200)
  logoUrl               String?  @map("logo_url") @db.VarChar(512)
  description           String?  @db.Text

  promptPayPhone        String?  @map("prompt_pay_phone") @db.VarChar(20)
  bankName              String?  @map("bank_name") @db.VarChar(120)
  bankAccountName       String?  @map("bank_account_name") @db.VarChar(200)
  bankAccountNumber     String?  @map("bank_account_number") @db.VarChar(64)
  paymentNote           String?  @map("payment_note") @db.Text

  /** โดเมนส่วนตัว (ชี้ DNS มาที่ MAWELL) — ยังไม่ verify ได้จนกว่าจะตั้งค่า middleware */
  customDomain          String?  @map("custom_domain") @db.VarChar(255)
  customDomainVerified  Boolean  @default(false) @map("custom_domain_verified")

  /** โหมด Sale Page — สินค้าเด่นหน้าเดียว (TikTok/FB) */
  salePageEnabled       Boolean  @default(false) @map("sale_page_enabled")
  featuredProductId     String?  @map("featured_product_id") @db.VarChar(191)

  /** แจ้งเตือนสต๊อกใกล้หมดเมื่อ stockBalance <= threshold */
  lowStockThreshold     Int      @default(5) @map("low_stock_threshold")

  /** Merchant ปิดหน้าร้องชั่วคราว (ไม่รวมกรณีโทเคนหมด) */
  merchantPaused        Boolean  @default(false) @map("merchant_paused")

  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  categories            EcommerceCategory[]
  products              EcommerceProduct[]
  orders                EcommerceOrder[]
  buyerCustomers        EcommerceBuyerCustomer[]
  featuredProduct       EcommerceProduct? @relation("EcommerceFeaturedProduct", fields: [featuredProductId], references: [id], onDelete: SetNull)

  @@unique([ownerUserId, trialSessionId], map: "ecstore_owner_trial_uniq")
  @@index([ownerUserId], map: "ecstore_owner_idx")
  @@index([customDomain], map: "ecstore_custom_domain_idx")
  @@map("ecommerce_stores")
}

/** หมวดหมู่สินค้าในร้าน */
model EcommerceCategory {
  id              String   @id @default(cuid())
  storeId         String   @map("store_id") @db.VarChar(191)
  store           EcommerceStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ownerUserId     String   @map("owner_id") @db.VarChar(191)
  owner           User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  name            String   @db.VarChar(120)
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  products        EcommerceProduct[]

  @@unique([storeId, name], map: "eccat_store_name_uidx")
  @@index([storeId, isActive, sortOrder], map: "eccat_store_active_sort_idx")
  @@index([ownerUserId], map: "eccat_owner_idx")
  @@map("ecommerce_categories")
}

model EcommerceProduct {
  id              String   @id @default(cuid())
  storeId         String   @map("store_id") @db.VarChar(191)
  store           EcommerceStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ownerUserId     String   @map("owner_id") @db.VarChar(191)
  owner           User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  name            String   @db.VarChar(255)
  imageUrl        String?  @map("image_url") @db.VarChar(512)
  description     String?  @db.Text
  priceBaht       Decimal  @map("price_baht") @db.Decimal(12, 2)
  sku             String?  @db.VarChar(64)
  stockBalance    Int      @default(0) @map("stock_balance")
  isActive        Boolean  @default(true) @map("is_active")
  /** แสดงป้าย/แถวสินค้าแนะนำบนหน้าร้อง */
  isRecommended   Boolean  @default(false) @map("is_recommended")
  /** แสดงป้าย/แถวขายดีบนหน้าร้อง */
  isBestseller    Boolean  @default(false) @map("is_bestseller")
  sortOrder       Int      @default(0) @map("sort_order")
  categoryId      String?  @map("category_id") @db.VarChar(191)
  category        EcommerceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  orderItems      EcommerceOrderItem[]
  featuredInStore EcommerceStore[] @relation("EcommerceFeaturedProduct")

  @@index([storeId, isActive, sortOrder], map: "ecprod_store_active_sort_idx")
  @@index([storeId, isActive, isRecommended], map: "ecprod_store_recommended_idx")
  @@index([storeId, isActive, isBestseller], map: "ecprod_store_bestseller_idx")
  @@index([storeId, categoryId], map: "ecprod_store_category_idx")
  @@index([ownerUserId], map: "ecprod_owner_idx")
  @@unique([storeId, sku], map: "ecprod_store_sku_uidx")
  @@map("ecommerce_products")
}

model EcommerceOrder {
  id                String               @id @default(cuid())
  storeId           String               @map("store_id") @db.VarChar(191)
  store             EcommerceStore       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ownerUserId       String               @map("owner_id") @db.VarChar(191)
  owner             User                 @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  referenceCode     String               @map("reference_code") @db.VarChar(32)
  /** รหัสติดตามสาธารณะสำหรับผู้ซื้อ (ไม่ใช่ cuid) */
  trackingCode      String               @map("tracking_code") @db.VarChar(24)

  customerName      String               @map("customer_name") @db.VarChar(200)
  customerPhone     String               @map("customer_phone") @db.VarChar(32)
  customerAddress   String?              @map("customer_address") @db.Text

  totalAmount       Decimal              @map("total_amount") @db.Decimal(14, 2)
  paymentSlipUrl    String?              @map("payment_slip_url") @db.VarChar(512)
  status            EcommerceOrderStatus @default(PENDING_SLIP)
  buyerCustomerId   String?              @map("buyer_customer_id") @db.VarChar(191)
  buyerCustomer     EcommerceBuyerCustomer? @relation(fields: [buyerCustomerId], references: [id], onDelete: SetNull)

  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  items             EcommerceOrderItem[]

  @@unique([storeId, referenceCode], map: "ecord_store_ref_uidx")
  @@unique([trackingCode], map: "ecord_tracking_uidx")
  @@index([storeId, status, createdAt], map: "ecord_store_status_idx")
  @@index([ownerUserId], map: "ecord_owner_idx")
  @@map("ecommerce_orders")
}

model EcommerceOrderItem {
  id              String          @id @default(cuid())
  orderId         String          @map("order_id") @db.VarChar(191)
  order           EcommerceOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String?         @map("product_id") @db.VarChar(191)
  product         EcommerceProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productName     String          @map("product_name") @db.VarChar(255)
  quantity        Int
  unitPriceBaht   Decimal         @map("unit_price_baht") @db.Decimal(12, 2)
  lineTotalBaht   Decimal         @map("line_total_baht") @db.Decimal(14, 2)

  @@index([orderId], map: "ecorditem_order_idx")
  @@map("ecommerce_order_items")
}

/** CRM — ลูกค้าที่เคยซื้อจากร้านนี้ */
model EcommerceBuyerCustomer {
  id              String   @id @default(cuid())
  storeId         String   @map("store_id") @db.VarChar(191)
  store           EcommerceStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ownerUserId     String   @map("owner_id") @db.VarChar(191)
  owner           User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  name            String   @db.VarChar(200)
  phone           String   @db.VarChar(32)
  totalSpendBaht  Decimal  @default(0) @map("total_spend_baht") @db.Decimal(14, 2)
  orderCount      Int      @default(0) @map("order_count")
  lastOrderAt     DateTime? @map("last_order_at")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  orders          EcommerceOrder[]

  @@unique([storeId, phone], map: "ecbuyer_store_phone_uidx")
  @@index([ownerUserId], map: "ecbuyer_owner_idx")
  @@map("ecommerce_buyer_customers")
}

// --- Smart Police (สำนวนคดี / พิมพ์หมาย / รายงาน — อิง SmartPolice desktop) ---

enum SmartPoliceCaseStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum SmartPolicePartyRole {
  COMPLAINANT
  SUSPECT
  WITNESS
  OFFICER
  OTHER
}

enum SmartPoliceDocumentKind {
  NARRATIVE
  STATEMENT
  WARRANT
  REPORT
  MEMO
  OTHER
}

model SmartPoliceProfile {
  id                 String   @id @default(cuid())
  ownerUserId        String   @unique @map("owner_user_id") @db.VarChar(191)
  owner              User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  stationName        String   @map("station_name") @db.VarChar(200)
  stationAddress     String?  @map("station_address") @db.Text
  province           String?  @db.VarChar(120)
  commanderRank      String?  @map("commander_rank") @db.VarChar(80)
  commanderName      String?  @map("commander_name") @db.VarChar(200)
  investigatorDefault String? @map("investigator_default") @db.VarChar(200)
  caseNumberPrefix   String   @default("ส.") @map("case_number_prefix") @db.VarChar(32)
  printFooter        String?  @map("print_footer") @db.Text
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("smart_police_profiles")
}

model SmartPoliceCase {
  id            String               @id @default(cuid())
  ownerUserId   String               @map("owner_user_id") @db.VarChar(191)
  owner         User                 @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  caseNumber    String               @map("case_number") @db.VarChar(64)
  title         String               @db.VarChar(255)
  caseType      String               @default("คดีอาญา") @map("case_type") @db.VarChar(80)
  status        SmartPoliceCaseStatus @default(OPEN)
  incidentAt    DateTime?            @map("incident_at")
  incidentPlace String?              @map("incident_place") @db.Text
  summary       String?              @db.Text
  printCount    Int                  @default(0) @map("print_count")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  parties   SmartPoliceParty[]
  documents SmartPoliceDocument[]

  @@unique([ownerUserId, caseNumber], map: "spcase_owner_number_uidx")
  @@index([ownerUserId, status, updatedAt], map: "spcase_owner_status_idx")
  @@map("smart_police_cases")
}

model SmartPoliceParty {
  id          String              @id @default(cuid())
  caseId      String              @map("case_id") @db.VarChar(191)
  case        SmartPoliceCase     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  role        SmartPolicePartyRole
  fullName    String              @map("full_name") @db.VarChar(200)
  age         Int?
  nationality String?             @default("ไทย") @db.VarChar(64)
  idCard      String?             @map("id_card") @db.VarChar(32)
  address     String?             @db.Text
  phone       String?             @db.VarChar(32)
  sortOrder   Int                 @default(0) @map("sort_order")

  statementDocuments SmartPoliceDocument[]

  @@index([caseId], map: "spparty_case_idx")
  @@map("smart_police_parties")
}

model SmartPoliceDocument {
  id            String                @id @default(cuid())
  caseId        String                @map("case_id") @db.VarChar(191)
  case          SmartPoliceCase       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  partyId       String?               @map("party_id") @db.VarChar(191)
  party         SmartPoliceParty?     @relation(fields: [partyId], references: [id], onDelete: SetNull)
  kind          SmartPoliceDocumentKind
  title         String                @db.VarChar(200)
  content       String                @db.MediumText
  wordFileUrl   String?               @map("word_file_url") @db.VarChar(512)
  wordFileName  String?               @map("word_file_name") @db.VarChar(255)
  printCount    Int                   @default(0) @map("print_count")
  lastPrintedAt DateTime?             @map("last_printed_at")
  sortOrder     Int                   @default(0) @map("sort_order")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  @@index([caseId, kind], map: "spdoc_case_kind_idx")
  @@index([partyId], map: "spdoc_party_idx")
  @@map("smart_police_documents")
}

model SmartPoliceTemplate {
  id          String                @id @default(cuid())
  ownerUserId String?               @map("owner_user_id") @db.VarChar(191)
  owner       User?                 @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  kind        SmartPoliceDocumentKind
  name        String                @db.VarChar(200)
  content     String                @db.MediumText
  sortOrder   Int                   @default(0) @map("sort_order")
  isBuiltin   Boolean               @default(false) @map("is_builtin")
  isActive    Boolean               @default(true) @map("is_active")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  @@index([ownerUserId, kind, isActive], map: "sptpl_owner_kind_idx")
  @@map("smart_police_templates")
}

model FootballTurfShopProfile {
  id              Int      @id @default(autoincrement())
  ownerUserId     String   @map("owner_id") @db.VarChar(191)
  owner           User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  trialSessionId  String   @default("prod") @map("trial_session_id") @db.VarChar(36)
  venueName       String   @default("") @map("venue_name") @db.VarChar(200)
  venueSubtitle   String   @default("") @map("venue_subtitle") @db.VarChar(300)
  /** โลโก้สนาม — path สั้นใต้ /uploads หรือ URL */
  logoUrl         String   @default("") @map("logo_url") @db.VarChar(512)
  promptpayNumber String   @default("") @map("promptpay_number") @db.VarChar(32)
  /** รูป QR พร้อมเพย์ที่อัปโหลดเอง (ทางเลือก — ใช้แทนการสร้างจากเบอร์) */
  promptPayQrImageUrl String? @map("prompt_pay_qr_image_url") @db.VarChar(512)
  bankName        String   @default("") @map("bank_name") @db.VarChar(120)
  accountName     String   @default("") @map("account_name") @db.VarChar(200)
  accountNumber   String   @default("") @map("account_number") @db.VarChar(32)
  venueAddress    String   @map("venue_address") @db.Text
  taxId           String   @default("") @map("tax_id") @db.VarChar(30)
  contactPhone    String   @default("") @map("contact_phone") @db.VarChar(32)
  contactLine     String   @default("") @map("contact_line") @db.VarChar(120)
  note            String   @db.Text
  /** ขนาดสลิปใบเสร็จของโมดูลนี้: SLIP_58 | SLIP_80 | A4 */
  slipPaperSize   String   @default("SLIP_58") @map("slip_paper_size") @db.VarChar(16)
  /**
   * การชำระตอนจองจากลิงก์ลูกค้า: NONE | DEPOSIT | FULL
   */
  portalBookingPaymentMode String @default("NONE") @map("portal_booking_payment_mode") @db.VarChar(16)
  /** จำนวนมัดจำ (บาท) เมื่อโหมด DEPOSIT */
  depositAmountBaht Int? @map("deposit_amount_baht")
  /** รหัสเข้าลิงก์พนักงานรายวัน (bcrypt) — ว่าง = ไม่บังคับ */
  staffDailyPinHash String? @map("staff_daily_pin_hash") @db.VarChar(255)
  /** แบนเนอร์หน้าเว็บจองลูกค้า */
  portalBannerUrl String? @map("portal_banner_url") @db.VarChar(512)
  /** แกลเลอรีหน้าเว็บจอง — JSON array ของ URL */
  portalGalleryJson String @default("[]") @map("portal_gallery_json") @db.Text
  facebookUrl String @default("") @map("facebook_url") @db.VarChar(512)
  mapUrl      String @default("") @map("map_url") @db.VarChar(512)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([ownerUserId, trialSessionId])
  @@index([ownerUserId])
  @@map("football_turf_shop_profiles")
}

model FootballTurfCourt {
  id             Int      @id @default(autoincrement())
  ownerUserId    String   @map("owner_id") @db.VarChar(191)
  owner          User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  trialSessionId String   @default("prod") @map("trial_session_id") @db.VarChar(36)
  name           String   @db.VarChar(120)
  openTime       String   @map("open_time") @db.VarChar(5)
  closeTime      String   @map("close_time") @db.VarChar(5)
  slotMinutes    Int      @default(60) @map("slot_minutes")
  weekdayPrice   Int      @default(0) @map("weekday_price")
  weekendPrice   Int      @default(0) @map("weekend_price")
  /** รูปปกสนาม — path ใต้ public เช่น /uploads/football-turf/... */
  imageUrl       String?  @map("image_url") @db.VarChar(512)
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
