  earnedAt       DateTime                   @map("earned_at")
  amount         Int
  itemLabel      String                     @default("") @map("item_label") @db.VarChar(200)
  note           String                     @default("") @db.VarChar(500)
  paymentSlipUrl String                     @default("") @map("payment_slip_url") @db.VarChar(512)
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")

  @@index([ownerUserId, trialSessionId, earnedAt], map: "ft_income_ent_owner_trial_earned_idx")
  @@map("football_turf_income_entries")
}

/** ลิงก์/QR พนักงานสนามฟุตบอล — โทเค็น + cipher สำหรับ QR ค้าง */
model FootballTurfStaffLink {
  id             String   @id @default(cuid())
  ownerUserId    String   @map("owner_id") @db.VarChar(191)
  owner          User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  trialSessionId String   @default("prod") @map("trial_session_id") @db.VarChar(36)
  tokenHash      String   @map("token_hash") @db.VarChar(128)
  tokenCipher    String?  @map("token_cipher") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([ownerUserId, trialSessionId], map: "football_turf_staff_link_owner_trial_uniq")
  @@index([ownerUserId], map: "football_turf_staff_link_owner_idx")
  @@map("football_turf_staff_links")
}

