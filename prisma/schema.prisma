  imageUrl      String?        @map("image_url") @db.VarChar(500)
  /** JSON: label + price ต่อขนาดตะกร้า (array of objects) */
  basketTiers   Json?          @map("basket_tiers")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  orders        LaundryOrder[]

  @@index([ownerUserId, trialSessionId, isActive], map: "laundry_pkg_owner_trial_active_idx")
  @@index([ownerUserId], map: "laundry_pkg_owner_idx")
  @@map("laundry_packages")
}

/** ออเดอร์ซัก — สอดคล้องกับ `laundry_orders` (migration) */
