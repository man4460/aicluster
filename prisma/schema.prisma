/** แพ็กซักรีด — สอดคล้องกับ `laundry_packages` (migration) */
model LaundryPackage {
  id            Int            @id @default(autoincrement())
  ownerUserId   String         @map("owner_id") @db.VarChar(191)
  owner         User           @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  trialSessionId String        @default("prod") @map("trial_session_id") @db.VarChar(36)
  name          String         @db.VarChar(160)
  pricingModel  String         @map("pricing_model") @db.VarChar(16)
  basePrice     Int            @map("base_price")
  durationHours Decimal        @default(24) @map("duration_hours") @db.Decimal(10, 3)
  description   String         @default("") @db.VarChar(800)
