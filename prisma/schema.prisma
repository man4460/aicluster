  meta           Json?
  note           String?             @db.Text
  recordedAt     DateTime            @default(now()) @map("recorded_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@unique([studentId, date, feature], map: "edu_rec_student_date_feature_uidx")
  @@index([ownerUserId, trialSessionId, date], map: "edu_rec_owner_trial_date_idx")
  @@index([classroomId, date], map: "edu_rec_classroom_date_idx")
  @@map("educare_check_records")
}

model EducareSettings {
  id              Int      @id @default(autoincrement())
  ownerUserId     String   @map("owner_id") @db.VarChar(191)
  owner           User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  trialSessionId  String   @default("prod") @map("trial_session_id") @db.VarChar(36)
  schoolName      String?  @map("school_name") @db.VarChar(120)
