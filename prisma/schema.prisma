/* ============================================================================
 * Doc Transmission — สารบรรณดิจิทัล (รับ-ส่งหนังสือ)
 * ============================================================================ */

enum DocCategory {
  ORDERS
  MEMOS
  INCOMING
  OUTGOING
  CIRCULARS
}

enum DocStatus {
  NORMAL
  IN_PROGRESS
  DONE
  CANCELED
}

enum DocPriority {
  NORMAL
  URGENT
  IMMEDIATE
}

enum DocTimelineAction {
  CREATED
  RECEIVED
  REGISTERED
  ASSIGNED
  IN_TRANSIT
  SIGNED
  DELIVERED
  COMPLETED
  CANCELED
  NOTE
  FILE_REPLACED
  STATUS_CHANGED
}

enum DocAuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  ASSIGN
  FILE_REPLACE
  SHARE_ENABLED
  SHARE_DISABLED
  TIMELINE_ADDED
}

model DocTransmissionDepartment {
  id              Int      @id @default(autoincrement())
  ownerUserId     String   @map("owner_id") @db.VarChar(191)
  owner           User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  trialSessionId  String   @default("prod") @map("trial_session_id") @db.VarChar(36)
  code            String   @db.VarChar(20)
  name            String   @db.VarChar(160)
  contactPerson   String?  @map("contact_person") @db.VarChar(120)
  phone           String?  @db.VarChar(40)
  email           String?  @db.VarChar(160)
  isInternal      Boolean  @default(true) @map("is_internal")
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  records         DocTransmissionRecord[]
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([ownerUserId, trialSessionId, code], map: "doc_dept_owner_trial_code_uidx")
  @@index([ownerUserId, trialSessionId, isActive], map: "doc_dept_owner_trial_active_idx")
  @@map("doc_transmission_departments")
}

model DocTransmissionRecord {
  id                BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  ownerUserId       String                @map("owner_id") @db.VarChar(191)
  owner             User                  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  trialSessionId    String                @default("prod") @map("trial_session_id") @db.VarChar(36)
  category          DocCategory
  /** ปีการศึกษา/ปีงบฯ (เช่น 2567) — ใช้ใน running number prefix */
  academicYear      String                @map("academic_year") @db.VarChar(8)
  /** เลขที่หนังสือเต็มรูปแบบ (เช่น "ORD-2567/0123") — auto-gen + แก้ได้ */
  docNumber         String                @map("doc_number") @db.VarChar(60)
  /** ลำดับวิ่ง (running seq) ต่อ category+year ต่อเจ้าของ — ใช้ออก docNumber อัตโนมัติ */
  runningSeq        Int                   @map("running_seq")
  subject           String                @db.VarChar(500)
  /** บุคคล/หน่วยงาน (ผู้สั่ง / ผู้ขอ / จากหน่วยงาน / ถึง / หน่วยงานที่แจ้ง) ตาม category */
  person            String?               @db.VarChar(255)
  departmentId      Int?                  @map("department_id")
  department        DocTransmissionDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  /** ลงวันที่ของเอกสาร (วันสั่ง/วันรับ/วันส่ง) */
  recordDate        DateTime              @map("record_date") @db.Date
  /** กำหนดดำเนินการให้แล้วเสร็จ */
  dueDate           DateTime?             @map("due_date") @db.Date
  status            DocStatus             @default(NORMAL)
  priority          DocPriority           @default(NORMAL)
  /** ชื่อผู้รับมอบ/ดำเนินการ (free text — ไม่ผูก userId เพื่อรองรับชื่อภายนอกระบบ) */
  assigneeName      String?               @map("assignee_name") @db.VarChar(160)
  /** หน่วยงานผู้รับมอบ */
  assigneeDept      String?               @map("assignee_dept") @db.VarChar(160)
  /** ไฟล์ปัจจุบัน (PDF) — มี revision history แยกในตาราง DocTransmissionAttachmentRevision */
  attachmentUrl     String?               @map("attachment_url") @db.VarChar(512)
  attachmentName    String?               @map("attachment_name") @db.VarChar(255)
  /** Token สำหรับ public read-only share (null = ปิด, มีค่า = เปิด) */
  publicShareToken  String?               @unique @map("public_share_token") @db.VarChar(64)
  publicShareEnabledAt DateTime?          @map("public_share_enabled_at")
  /** QR / Barcode สำหรับติดตามเอกสาร — auto-gen เมื่อสร้าง */
  trackingCode      String                @map("tracking_code") @db.VarChar(40)
  note              String?               @db.Text
  isDeleted         Boolean               @default(false) @map("is_deleted")
  timelineEntries   DocTransmissionTimelineEntry[]
  attachmentRevisions DocTransmissionAttachmentRevision[]
  auditLogs         DocTransmissionAuditLog[]
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  @@unique([ownerUserId, trialSessionId, category, academicYear, runningSeq], map: "doc_rec_owner_cat_year_seq_uidx")
  @@unique([ownerUserId, trialSessionId, trackingCode], map: "doc_rec_owner_trial_track_uidx")
  @@index([ownerUserId, trialSessionId, category, isDeleted], map: "doc_rec_owner_cat_idx")
  @@index([ownerUserId, trialSessionId, status], map: "doc_rec_owner_status_idx")
  @@index([ownerUserId, trialSessionId, recordDate], map: "doc_rec_owner_date_idx")
  @@index([ownerUserId, trialSessionId, dueDate], map: "doc_rec_owner_due_idx")
  @@index([departmentId], map: "doc_rec_dept_idx")
  @@map("doc_transmission_records")
}

model DocTransmissionTimelineEntry {
  id              BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  recordId        BigInt              @map("record_id") @db.UnsignedBigInt
  record          DocTransmissionRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  ownerUserId     String              @map("owner_id") @db.VarChar(191)
  trialSessionId  String              @default("prod") @map("trial_session_id") @db.VarChar(36)
  action          DocTimelineAction
  /** สถานะ "ก่อน/หลัง" สำหรับ STATUS_CHANGED */
  fromStatus      DocStatus?          @map("from_status")
  toStatus        DocStatus?          @map("to_status")
  note            String?             @db.Text
  actorUserId     String?             @map("actor_user_id") @db.VarChar(191)
  actor           User?               @relation("DocTransmissionTimelineActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorName       String?             @map("actor_name") @db.VarChar(160)
  occurredAt      DateTime            @default(now()) @map("occurred_at")
  createdAt       DateTime            @default(now()) @map("created_at")

  @@index([recordId, occurredAt], map: "doc_tl_rec_occ_idx")
  @@index([ownerUserId, trialSessionId, occurredAt], map: "doc_tl_owner_occ_idx")
  @@map("doc_transmission_timeline_entries")
}

model DocTransmissionAttachmentRevision {
  id              BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  recordId        BigInt              @map("record_id") @db.UnsignedBigInt
  record          DocTransmissionRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  ownerUserId     String              @map("owner_id") @db.VarChar(191)
  trialSessionId  String              @default("prod") @map("trial_session_id") @db.VarChar(36)
  fileUrl         String              @map("file_url") @db.VarChar(512)
  fileName        String              @map("file_name") @db.VarChar(255)
  fileSize        Int?                @map("file_size")
  mimeType        String?             @map("mime_type") @db.VarChar(120)
  /** ลำดับเวอร์ชัน (1 = ต้นฉบับ) */
  versionNo       Int                 @map("version_no")
  note            String?             @db.Text
  uploadedByUserId String?            @map("uploaded_by_user_id") @db.VarChar(191)
  uploadedBy      User?               @relation("DocTransmissionRevisionUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  uploadedByName  String?             @map("uploaded_by_name") @db.VarChar(160)
  createdAt       DateTime            @default(now()) @map("created_at")

  @@unique([recordId, versionNo], map: "doc_rev_rec_ver_uidx")
  @@index([ownerUserId, trialSessionId, createdAt], map: "doc_rev_owner_created_idx")
  @@map("doc_transmission_attachment_revisions")
}

model DocTransmissionAuditLog {
  id              BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  ownerUserId     String           @map("owner_id") @db.VarChar(191)
  trialSessionId  String           @default("prod") @map("trial_session_id") @db.VarChar(36)
  recordId        BigInt?          @map("record_id") @db.UnsignedBigInt
  record          DocTransmissionRecord? @relation(fields: [recordId], references: [id], onDelete: Cascade)
  action          DocAuditAction
  /** Snapshot สั้น ๆ ของ payload (JSON: before/after) */
  snapshot        Json?
  actorUserId     String?          @map("actor_user_id") @db.VarChar(191)
  actor           User?            @relation("DocTransmissionAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorName       String?          @map("actor_name") @db.VarChar(160)
  ipAddress       String?          @map("ip_address") @db.VarChar(64)
  userAgent       String?          @map("user_agent") @db.VarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([ownerUserId, trialSessionId, createdAt], map: "doc_audit_owner_created_idx")
  @@index([recordId, createdAt], map: "doc_audit_rec_created_idx")
  @@index([ownerUserId, trialSessionId, action], map: "doc_audit_owner_action_idx")
  @@map("doc_transmission_audit_logs")
}

model DocTransmissionSettings {
  id              Int      @id @default(autoincrement())
  ownerUserId     String   @map("owner_id") @db.VarChar(191)
  owner           User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  trialSessionId  String   @default("prod") @map("trial_session_id") @db.VarChar(36)
  orgName         String?  @map("org_name") @db.VarChar(200)
  orgAddress      String?  @map("org_address") @db.Text
  orgPhone        String?  @map("org_phone") @db.VarChar(40)
  defaultYear     String?  @map("default_year") @db.VarChar(8)
  ordersPrefix    String   @default("ORD") @map("orders_prefix") @db.VarChar(10)
  memosPrefix     String   @default("MEM") @map("memos_prefix") @db.VarChar(10)
  incomingPrefix  String   @default("IN") @map("incoming_prefix") @db.VarChar(10)
  outgoingPrefix  String   @default("OUT") @map("outgoing_prefix") @db.VarChar(10)
  circularsPrefix String   @default("CIR") @map("circulars_prefix") @db.VarChar(10)
  trackPrefix     String   @default("DOC") @map("track_prefix") @db.VarChar(10)
  /** เปิด-ปิด public share โดยรวม (override ราย record) */
  publicShareEnabled Boolean @default(true) @map("public_share_enabled")
  createdAt       DateTime @default(now()) @map("created_at")
