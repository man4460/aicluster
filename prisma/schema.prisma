/** ตั้งค่าเขตเวลา + จุดเช็คอิน — ต่อเจ้าขององค์กร (owner user) */
model AttendanceSettings {
  id                   Int      @id @default(autoincrement())
  ownerUserId          String   @map("owner_id") @db.VarChar(191)
  owner                User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  /** `prod` = ข้อมูลจริง | cuid = ชุดทดลอง */
  trialSessionId       String   @default("prod") @map("trial_session_id") @db.VarChar(36)
  /** เวลาเริ่มกะ รูปแบบ HH:mm (เวลาไทย) */
  shiftStartTime       String   @default("09:00") @map("shift_start_time") @db.VarChar(5)
  shiftEndTime         String   @default("18:00") @map("shift_end_time") @db.VarChar(5)
  allowedLocationLat   Float    @map("allowed_location_lat")
  allowedLocationLng   Float    @map("allowed_location_lng")
  radiusMeters         Int      @default(120) @map("radius_meters")
  /** เปิดทางเลือกเช็คอินด้วยสแกนใบหน้า (เปรียบเทียบในระบบ) */
  faceCheckInEnabled   Boolean  @default(false) @map("face_check_in_enabled")
  /** เปิด API สำหรับอุปกรณ์ (ESP32 ฯลฯ) */
  deviceApiEnabled     Boolean  @default(false) @map("device_api_enabled")
  /** bcrypt ของ device API key */
  deviceApiKeyHash     String?  @map("device_api_key_hash") @db.VarChar(255)
  /** ท้ายคีย์ 4 ตัวสำหรับแสดงใน UI */
  deviceApiKeyHint     String?  @map("device_api_key_hint") @db.VarChar(16)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@unique([ownerUserId, trialSessionId], map: "atset_owner_trial_uidx")
  @@index([ownerUserId], map: "atset_owner_id_idx")
  @@map("attendance_settings")
}

/** โลเคชันจุดเช็ค (หลายจุดตามแพ็กเกจ) — กะสูงสุด 5 ต่อจุด */
model AttendanceLocation {
  id                 Int               @id @default(autoincrement())
  ownerUserId        String            @map("owner_id") @db.VarChar(191)
  owner              User              @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  trialSessionId     String            @default("prod") @map("trial_session_id") @db.VarChar(36)
  name               String            @default("จุดเช็ค") @db.VarChar(80)
  allowedLocationLat Float             @map("allowed_location_lat")
  allowedLocationLng Float             @map("allowed_location_lng")
  radiusMeters       Int               @default(120) @map("radius_meters")
  sortOrder          Int               @default(0) @map("sort_order")
  shifts             AttendanceShift[]
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@index([ownerUserId, trialSessionId, sortOrder], map: "aloc_owner_trial_sort_idx")
  @@index([ownerUserId], map: "aloc_owner_id_idx")
  @@map("attendance_locations")
}

model AttendanceShift {
  id         Int                @id @default(autoincrement())
  locationId Int                @map("location_id")
  location   AttendanceLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  startTime  String             @map("start_time") @db.VarChar(5)
  endTime    String             @map("end_time") @db.VarChar(5)
  sortOrder  Int                @default(0) @map("sort_order")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  @@index([locationId, sortOrder])
  @@map("attendance_shifts")
}

/** รายชื่อพนักงานสำหรับเช็คผ่าน QR/ลิงก์สาธารณะ — ยืนยันด้วยเบอร์ */
model AttendanceRosterEntry {
  id          Int      @id @default(autoincrement())
  ownerUserId String   @map("owner_id") @db.VarChar(191)
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  trialSessionId String @default("prod") @map("trial_session_id") @db.VarChar(36)
  displayName String   @map("display_name") @db.VarChar(100)
  phone       String   @map("phone") @db.VarChar(20)
  isActive    Boolean  @default(true) @map("is_active")
  /** ลำดับกะในโลเคชัน (0 = กะแรก ตาม sort_order) สูงสุด 4 ถ้ามี 5 กะ */
  rosterShiftIndex Int @default(0) @map("roster_shift_index")
  /** รูปโปรไฟล์รายชื่อ (path ใต้ public เช่น /uploads/attendance-roster/...) */
  photoUrl    String?  @map("photo_url") @db.VarChar(512)
  /** เวกเตอร์ใบหน้า (JSON float[128]) — ประมวลผลในระบบ ไม่ส่ง API ภายนอก */
  faceDescriptorJson String? @map("face_descriptor_json") @db.LongText
  faceEnrolledAt     DateTime? @map("face_enrolled_at")
  /** รหัสนิ้วบนเซ็นเซอร์ ESP32 (เช่น AS608/R307 slot 1–127) */
  fingerprintSlot    Int?      @map("fingerprint_slot")
  fingerprintEnrolledAt DateTime? @map("fingerprint_enrolled_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([ownerUserId, phone, trialSessionId])
  @@index([ownerUserId, trialSessionId, isActive])
  @@index([ownerUserId, trialSessionId, fingerprintSlot], map: "arost_owner_trial_fp_idx")
  @@map("attendance_roster_entries")
}

/** บันทึกเช็คเข้า-ออก — actor = User แพลตฟอร์ม หรือ guest ผ่านเบอร์ */
model AttendanceLog {
  id              Int                      @id @default(autoincrement())
  ownerUserId     String                   @map("owner_id") @db.VarChar(191)
  owner           User                     @relation("AttendanceOrg", fields: [ownerUserId], references: [id], onDelete: Cascade)
  trialSessionId  String                   @default("prod") @map("trial_session_id") @db.VarChar(36)
  actorUserId     String?                  @map("actor_user_id") @db.VarChar(191)
  actor           User?                    @relation("AttendanceActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  guestPhone      String?                      @map("guest_phone") @db.VarChar(20)
  guestName       String?                      @map("guest_name") @db.VarChar(100)
  /** ใช้เมื่อเช็คผ่านลิงก์สาธารณะ — แยกพนักงานในรายชื่อ vs บุคคลภายนอก */
  publicVisitorKind AttendancePublicVisitorKind? @map("public_visitor_kind")
  checkInTime     DateTime?                @map("check_in_time")
  checkOutTime    DateTime?                @map("check_out_time")
  checkInLat      Float?                   @map("check_in_lat")
  checkInLng      Float?                   @map("check_in_lng")
  checkOutLat     Float?                   @map("check_out_lat")
  checkOutLng     Float?                   @map("check_out_lng")
  status          AttendanceSummaryStatus  @default(AWAITING_CHECKOUT) @map("status")
  lateCheckIn     Boolean                  @default(false) @map("late_check_in")
  earlyCheckOut   Boolean                  @default(false) @map("early_check_out")
  /** รูปใบหน้าตอนเช็คเข้า (ลิงก์ใน public/uploads) — บังคับถ่ายก่อนเช็คเข้า */
  checkInFacePhotoUrl String?              @map("check_in_face_photo_url") @db.VarChar(512)
  /** กะที่ใช้คำนวณมาสาย/ออกก่อนเวลา ณ เวลาเช็คเข้า (ลำดับในโลเคชัน) */
  appliedShiftIndex Int?                   @map("applied_shift_index")
  note            String?                  @db.VarChar(500)
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  @@index([ownerUserId, trialSessionId, checkInTime], map: "alog_owner_trial_in_idx")
  @@index([ownerUserId, trialSessionId, guestPhone], map: "alog_owner_trial_phone_idx")
  @@index([ownerUserId], map: "alog_owner_id_idx")
  @@index([actorUserId])
  @@map("attendance_logs")
}

/** รายรับ-รายจ่ายในบ้าน/ร้าน (กลุ่ม 1) */
model HomeFinanceEntry {
  id               Int                 @id @default(autoincrement())
  ownerUserId      String              @map("owner_id") @db.VarChar(191)
  owner            User                @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  entryDate        DateTime            @map("entry_date") @db.Date
  type             HomeFinanceEntryType
  categoryKey      String              @map("category_key") @db.VarChar(64)
  categoryLabel    String              @map("category_label") @db.VarChar(100)
  title            String              @db.VarChar(160)
  amount           Decimal             @db.Decimal(12, 2)
  dueDate          DateTime?           @map("due_date") @db.Date
  billNumber       String?             @map("bill_number") @db.VarChar(100)
  vehicleType      String?             @map("vehicle_type") @db.VarChar(40)
  serviceCenter    String?             @map("service_center") @db.VarChar(160)
  paymentMethod    String?             @map("payment_method") @db.VarChar(40)
  note             String?             @db.VarChar(600)
  slipImageUrl     String?             @map("slip_image_url") @db.VarChar(512)
  /** URL หลายไฟล์ (รูป/PDF) — slipImageUrl เก็บไฟล์แรกเพื่อความเข้ากันได้ */
  attachmentUrls   Json?               @map("attachment_urls")
  linkedUtilityId  Int?                @map("linked_utility_id")
  linkedVehicleId  Int?                @map("linked_vehicle_id")
  linkedUtility    HomeUtilityProfile? @relation(fields: [linkedUtilityId], references: [id], onDelete: SetNull)
  linkedVehicle    HomeVehicleProfile? @relation(fields: [linkedVehicleId], references: [id], onDelete: SetNull)
  externalSource   String?             @map("external_source") @db.VarChar(40)
  externalId       String?             @map("external_id") @db.VarChar(128)
  lastSyncedAt     DateTime?           @map("last_synced_at")
  slipExtractions  HomeFinanceSlipExtraction[]
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@index([ownerUserId, entryDate])
  @@index([ownerUserId, categoryKey])
  @@index([ownerUserId, externalSource, externalId], map: "home_finance_entries_owner_external_idx")
  @@index([linkedUtilityId])
  @@index([linkedVehicleId])
  @@map("home_finance_entries")
}

model HomeFinanceSlipExtraction {
  id                   Int                             @id @default(autoincrement())
  ownerUserId          String                          @map("owner_id") @db.VarChar(191)
  owner                User                            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  entryId              Int?                            @map("entry_id")
  entry                HomeFinanceEntry?               @relation(fields: [entryId], references: [id], onDelete: SetNull)
  sourceUrl            String                          @map("source_url") @db.VarChar(512)
  mimeType             String                          @map("mime_type") @db.VarChar(80)
  status               HomeFinanceSlipExtractionStatus @map("status")
  confidence           Decimal?                        @db.Decimal(5, 4)
  predictedType        HomeFinanceEntryType?           @map("predicted_type")
  predictedAmount      Decimal?                        @map("predicted_amount") @db.Decimal(12, 2)
  predictedEntryDate   DateTime?                       @map("predicted_entry_date") @db.Date
  predictedTitle       String?                         @map("predicted_title") @db.VarChar(200)
  predictedBillNumber  String?                         @map("predicted_bill_number") @db.VarChar(120)
  predictedPaymentMethod String?                       @map("predicted_payment_method") @db.VarChar(60)
  rawOcrText           String?                         @map("raw_ocr_text") @db.Text
  rawAiJson            Json?                           @map("raw_ai_json")
  errorMessage         String?                         @map("error_message") @db.VarChar(300)
  createdAt            DateTime                        @default(now()) @map("created_at")
  updatedAt            DateTime                        @updatedAt @map("updated_at")

  @@index([ownerUserId, createdAt], map: "hf_slip_extract_owner_created_idx")
  @@index([entryId], map: "hf_slip_extract_entry_idx")
  @@index([ownerUserId, status], map: "hf_slip_extract_owner_status_idx")
  @@map("home_finance_slip_extractions")
}

/**
 * คลังรหัสผ่าน (vault) — เก็บ username/password ของบริการต่าง ๆ ของผู้ใช้
 * passwordEnc = AES-256-GCM blob (base64url) ใช้ key จาก AUTH_SECRET
 */
model VaultEntry {
  id            Int       @id @default(autoincrement())
  ownerUserId   String    @map("owner_id") @db.VarChar(191)
  owner         User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  serviceName   String    @map("service_name") @db.VarChar(120)
  username      String    @db.VarChar(255)
  passwordEnc   String    @map("password_enc") @db.Text
  websiteUrl    String?   @map("website_url") @db.VarChar(500)
  category      String?   @db.VarChar(64)
  /** preset ของ brand เช่น google/facebook/instagram — ใช้แสดงไอคอน/สี ในการ์ด */
  brandKey      String?   @map("brand_key") @db.VarChar(64)
  note          String?   @db.Text
  isFavorite    Boolean   @default(false) @map("is_favorite")
  lastUsedAt    DateTime? @map("last_used_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([ownerUserId, isFavorite])
  @@index([ownerUserId, lastUsedAt])
  @@index([ownerUserId, category])
  @@map("vault_entries")
}

/** คลังสินค้า / โกดัง — โมดูล inventory */
model InventoryWarehouse {
  id          Int      @id @default(autoincrement())
  ownerUserId String   @map("owner_id") @db.VarChar(191)
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  code        String   @db.VarChar(32)
  name        String   @db.VarChar(120)
  address     String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  stocks      InventoryStock[]
  movementsFrom InventoryMovement[] @relation("InventoryMovementFromWarehouse")
  movementsTo   InventoryMovement[] @relation("InventoryMovementToWarehouse")

  @@unique([ownerUserId, code], map: "inventory_warehouses_owner_code_uq")
  @@index([ownerUserId, isActive])
  @@map("inventory_warehouses")
}

/** หมวดสินค้า — โมดูล inventory */
model InventoryCategory {
  id          Int      @id @default(autoincrement())
  ownerUserId String   @map("owner_id") @db.VarChar(191)
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(120)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items       InventoryItem[]

  @@index([ownerUserId, isActive])
  @@map("inventory_categories")
}

/** สินค้า — SKU/ราคาทุน/ราคาขาย/จุดสั่งซื้อ */
model InventoryItem {
  id          Int      @id @default(autoincrement())
  ownerUserId String   @map("owner_id") @db.VarChar(191)
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  sku         String   @db.VarChar(64)
  name        String   @db.VarChar(160)
  categoryId  Int?     @map("category_id")
  category    InventoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit        String   @default("ชิ้น") @db.VarChar(24)
  costPrice   Decimal  @default(0) @map("cost_price") @db.Decimal(12, 2)
  salePrice   Decimal  @default(0) @map("sale_price") @db.Decimal(12, 2)
  /** จุดสั่งซื้อ (reorder point) — แสดงเตือนเมื่อ stock รวมต่ำกว่าค่านี้ */
  minStock    Int      @default(0) @map("min_stock")
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  note        String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  stocks      InventoryStock[]
  movements   InventoryMovement[]

  @@unique([ownerUserId, sku], map: "inventory_items_owner_sku_uq")
  @@index([ownerUserId, isActive])
  @@index([ownerUserId, categoryId])
  @@map("inventory_items")
}

/** สต๊อกคงเหลือต่อสินค้าต่อคลัง — atomic counter */
model InventoryStock {
  id          Int      @id @default(autoincrement())
  ownerUserId String   @map("owner_id") @db.VarChar(191)
  itemId      Int      @map("item_id")
  item        InventoryItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouseId Int      @map("warehouse_id")
  warehouse   InventoryWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([itemId, warehouseId], map: "inventory_stock_item_warehouse_uq")
  @@index([ownerUserId, warehouseId])
  @@index([ownerUserId, itemId])
  @@map("inventory_stocks")
}

enum InventoryMovementType {
  IN
  OUT
  TRANSFER
  ADJUST
}

/** ประวัติการเคลื่อนไหวสต๊อก */
model InventoryMovement {
  id              Int      @id @default(autoincrement())
  ownerUserId     String   @map("owner_id") @db.VarChar(191)
  owner           User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  type            InventoryMovementType
  itemId          Int      @map("item_id")
  item            InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /** คลังต้นทาง (OUT/TRANSFER/ADJUST=ลด) */
  fromWarehouseId Int?     @map("from_warehouse_id")
  fromWarehouse   InventoryWarehouse? @relation("InventoryMovementFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: SetNull)
  /** คลังปลายทาง (IN/TRANSFER/ADJUST=เพิ่ม) */
  toWarehouseId   Int?     @map("to_warehouse_id")
  toWarehouse     InventoryWarehouse? @relation("InventoryMovementToWarehouse", fields: [toWarehouseId], references: [id], onDelete: SetNull)
  quantity        Int
  /** ราคาทุนต่อหน่วยตอนเคลื่อนไหว (ถ้ามี) */
  unitCost        Decimal? @map("unit_cost") @db.Decimal(12, 2)
  reference       String?  @db.VarChar(120)
  note            String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([ownerUserId, createdAt])
  @@index([ownerUserId, itemId])
  @@index([ownerUserId, type, createdAt])
  @@map("inventory_movements")
}

/** หมวดของระบบรายรับ–รายจ่าย — รวมทั้ง built-in (isSystem=true, key=คงที่) และที่ผู้ใช้สร้างเอง (key=null) */
model HomeFinanceCategory {
  id          Int      @id @default(autoincrement())
  ownerUserId String   @map("owner_id") @db.VarChar(191)
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  /** built-in key เช่น `UTILITIES_ELECTRIC` — null สำหรับหมวดที่ผู้ใช้สร้างเอง */
  systemKey   String?  @map("system_key") @db.VarChar(64)
  /** built-in หมวดหลัก ลบไม่ได้ ปิดใช้งานได้ */
  isSystem    Boolean  @default(false) @map("is_system")
  name        String   @db.VarChar(100)
  sortOrder   Int      @default(100) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([ownerUserId, isActive])
  @@unique([ownerUserId, name])
  @@unique([ownerUserId, systemKey])
  @@map("home_finance_categories")
}

/** รายการบิลค่าน้ำ/ค่าไฟของบ้าน */
model HomeUtilityProfile {
  id             Int             @id @default(autoincrement())
  ownerUserId    String          @map("owner_id") @db.VarChar(191)
  owner          User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  utilityType    HomeUtilityType @map("utility_type")
  label          String          @db.VarChar(120)
  provider       String?         @db.VarChar(120)
  accountNumber  String?         @map("account_number") @db.VarChar(80)
  meterNumber    String?         @map("meter_number") @db.VarChar(80)
  defaultDueDay  Int?            @map("default_due_day")
  dueDate        DateTime?       @map("due_date") @db.Date
  note           String?         @db.VarChar(400)
  photoUrl       String?         @map("photo_url") @db.VarChar(512)
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  financeEntries HomeFinanceEntry[]

  @@index([ownerUserId, utilityType, isActive])
  @@map("home_utility_profiles")
}

/** รายการยานพาหนะในบ้าน */
model HomeVehicleProfile {
  id            Int             @id @default(autoincrement())
  ownerUserId   String          @map("owner_id") @db.VarChar(191)
  owner         User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  vehicleType   HomeVehicleType @map("vehicle_type")
  label         String          @db.VarChar(120)
  brand         String?         @db.VarChar(80)
  model         String?         @db.VarChar(80)
  plateNumber   String?         @map("plate_number") @db.VarChar(40)
  vehicleYear   Int?            @map("vehicle_year")
  taxDueDate    DateTime?       @map("tax_due_date") @db.Date
  serviceDueDate DateTime?      @map("service_due_date") @db.Date
  insuranceDueDate DateTime?    @map("insurance_due_date") @db.Date
  note          String?         @db.VarChar(400)
  photoUrl      String?         @map("photo_url") @db.VarChar(512)
  /** เอกสารประกอบ (เล่มทะเบียน กรมธรรม์ PDF ฯลฯ) หลายไฟล์ */
  attachmentUrls Json?          @map("attachment_urls")
  isActive      Boolean         @default(true) @map("is_active")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  financeEntries HomeFinanceEntry[]

  @@index([ownerUserId, vehicleType, isActive])
  @@map("home_vehicle_profiles")
}

/** แจ้งเตือนอื่นๆ สำหรับระบบรายรับรายจ่าย */
model HomeFinanceReminder {
  id          Int      @id @default(autoincrement())
  ownerUserId String   @map("owner_id") @db.VarChar(191)
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  title       String   @db.VarChar(160)
  dueDate     DateTime @map("due_date") @db.Date
  note        String?  @db.VarChar(400)
  isDone      Boolean  @default(false) @map("is_done")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([ownerUserId, dueDate, isDone])
  @@map("home_finance_reminders")
}

/** เอกสารส่วนตัว — เก็บไฟล์แยกจากสลิปรายการรายรับ–รายจ่าย */
model HomeFinancePersonalDocument {
  id          Int      @id @default(autoincrement())
