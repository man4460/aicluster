enum FootballTurfIncomeCategoryKind {
  COURT_RENTAL
  PROMOTION
  CUSTOM
}

/** หมวดรายรับ — ค่าสนาม / โปรโมชัน เป็น builtin · อื่น ๆ บันทึกมือ */
model FootballTurfIncomeCategory {
  id             Int                           @id @default(autoincrement())
  ownerUserId    String                        @map("owner_id") @db.VarChar(191)
  owner          User                          @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  trialSessionId String                        @default("prod") @map("trial_session_id") @db.VarChar(36)
  name           String                        @db.VarChar(120)
  kind           FootballTurfIncomeCategoryKind @default(CUSTOM)
  isBuiltin      Boolean                       @default(false) @map("is_builtin")
  sortOrder      Int                           @default(0) @map("sort_order")
  createdAt      DateTime                      @default(now()) @map("created_at")
  updatedAt      DateTime                      @updatedAt @map("updated_at")

  entries FootballTurfIncomeEntry[]

  @@index([ownerUserId, trialSessionId], map: "ft_income_cat_owner_trial_idx")
  @@index([ownerUserId, trialSessionId, kind], map: "ft_income_cat_owner_trial_kind_idx")
  @@map("football_turf_income_categories")
}

model FootballTurfIncomeEntry {
  id             Int                        @id @default(autoincrement())
  ownerUserId    String                     @map("owner_id") @db.VarChar(191)
  owner          User                       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
