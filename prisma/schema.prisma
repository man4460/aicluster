  code                String   @db.VarChar(20)
  name                String   @db.VarChar(120)
  headPersonName      String?  @map("head_person_name") @db.VarChar(120)
  description         String?  @db.Text
  isActive            Boolean  @default(true) @map("is_active")
  sortOrder           Int      @default(0) @map("sort_order")
  assets              Asset[]
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([ownerUserId, trialSessionId, code], map: "ast_dep_owner_trial_code_uidx")
  @@index([ownerUserId, trialSessionId, isActive], map: "ast_dep_owner_trial_active_idx")
  @@map("asset_departments")
}

model AssetLocation {
  id                  Int      @id @default(autoincrement())
  ownerUserId         String   @map("owner_id") @db.VarChar(191)
  owner               User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  trialSessionId      String   @default("prod") @map("trial_session_id") @db.VarChar(36)
