  actorName       String?          @map("actor_name") @db.VarChar(160)
  ipAddress       String?          @map("ip_address") @db.VarChar(64)
  userAgent       String?          @map("user_agent") @db.VarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([ownerUserId, trialSessionId, createdAt], map: "doc_audit_owner_created_idx")
  @@index([recordId, createdAt], map: "doc_audit_rec_created_idx")
  @@index([ownerUserId, trialSessionId, action], map: "doc_audit_owner_action_idx")
  @@map("doc_transmission_audit_logs")
}

model DocTransmissionSettings {
