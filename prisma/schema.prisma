  saleId        String   @map("sale_id") @db.VarChar(191)
  sale          GeneralStorePosSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId     String?  @map("product_id") @db.VarChar(191)
  product       GeneralStorePosProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName   String   @map("product_name") @db.VarChar(160)
