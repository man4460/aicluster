  bookingId      Int?     @unique @map("booking_id")
  booking        CarWashBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([ownerUserId, trialSessionId, visitAt], map: "cwash_visit_owner_trial_visit_idx")
  @@index([ownerUserId, trialSessionId, customerPhone], map: "cwash_visit_owner_trial_phone_idx")
  @@index([ownerUserId, trialSessionId, plateNumber], map: "cwash_visit_owner_trial_plate_idx")
  @@index([ownerUserId], map: "cwash_visit_owner_idx")
  @@map("car_wash_visits")
}

