  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([ownerUserId, trialSessionId, orderAt], map: "laundry_ord_owner_trial_order_idx")
  @@index([ownerUserId], map: "laundry_ord_owner_idx")
  @@map("laundry_orders")
}

