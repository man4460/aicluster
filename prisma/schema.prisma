  note           String   @default("") @db.VarChar(300)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([ownerUserId, trialSessionId, createdAt], map: "ft_loyalty_ledger_owner_trial_created_idx")
  @@index([memberId, createdAt], map: "ft_loyalty_ledger_member_created_idx")
  @@index([bookingId], map: "ft_loyalty_ledger_booking_idx")
  @@map("football_turf_loyalty_ledgers")
}

