  birthdate      DateTime?            @db.Date
  photoUrl       String?              @map("photo_url") @db.VarChar(512)
  parentName     String?              @map("parent_name") @db.VarChar(120)
  parentPhone    String?              @map("parent_phone") @db.VarChar(40)
  address        String?              @db.Text
  isActive       Boolean              @default(true) @map("is_active")
  records        EducareCheckRecord[]
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@unique([ownerUserId, trialSessionId, classroomId, studentNo], map: "edu_stu_owner_trial_room_no_uidx")
  @@index([ownerUserId, trialSessionId, classroomId], map: "edu_stu_owner_trial_room_idx")
  @@map("educare_students")
}

model EducareCheckRecord {
  id             BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  ownerUserId    String              @map("owner_id") @db.VarChar(191)
  owner          User                @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  trialSessionId String              @default("prod") @map("trial_session_id") @db.VarChar(36)
  studentId      Int                 @map("student_id")
  student        EducareStudent      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroomId    Int                 @map("classroom_id")
  classroom      EducareClassroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  date           DateTime            @db.Date
  feature        EducareCheckFeature
  status         EducareCheckStatus
