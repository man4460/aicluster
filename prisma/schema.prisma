// --- EduCare / ระบบเช็คนักเรียนประจำวัน 6 ฟีเจอร์ (กลุ่ม 1) ---

enum EducareCheckFeature {
  ASSEMBLY
  TIDINESS
  CLASS_ATTENDANCE
  MEAL
  BRUSHING
  MILK
}

/** สถานะรวม 3 ตระกูล: เข้าแถว/เข้าเรียน (PRESENT/LATE/ABSENT/EXCUSED), ความเรียบร้อย (PASS/FAIL/NA), กิจกรรม (DONE/PARTIAL/NOT_DONE/NA) */
enum EducareCheckStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
  PASS
  FAIL
  DONE
  PARTIAL
  NOT_DONE
  NA
}

model EducareSchool {
  id             Int                @id @default(autoincrement())
  ownerUserId    String             @map("owner_id") @db.VarChar(191)
  owner          User               @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  trialSessionId String             @default("prod") @map("trial_session_id") @db.VarChar(36)
  name           String             @db.VarChar(120)
  address        String?            @db.Text
  phone          String?            @db.VarChar(40)
  isActive       Boolean            @default(true) @map("is_active")
  classrooms     EducareClassroom[]
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@unique([ownerUserId, trialSessionId, name], map: "edu_sch_owner_trial_name_uidx")
  @@index([ownerUserId, trialSessionId], map: "edu_sch_owner_trial_idx")
  @@map("educare_schools")
}

model EducareClassroom {
  id                  Int                  @id @default(autoincrement())
  ownerUserId         String               @map("owner_id") @db.VarChar(191)
  owner               User                 @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  trialSessionId      String               @default("prod") @map("trial_session_id") @db.VarChar(36)
  schoolId            Int                  @map("school_id")
  school              EducareSchool        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name                String               @db.VarChar(60)
  grade               String?              @db.VarChar(40)
  level               String?              @db.VarChar(40)
  homeroomTeacherName String?              @map("homeroom_teacher_name") @db.VarChar(120)
  homeroomTeacherPhone String?             @map("homeroom_teacher_phone") @db.VarChar(40)
  isActive            Boolean              @default(true) @map("is_active")
  sortOrder           Int                  @default(0) @map("sort_order")
  students            EducareStudent[]
  records             EducareCheckRecord[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@index([ownerUserId, trialSessionId, schoolId, sortOrder], map: "edu_cls_owner_trial_school_sort_idx")
  @@index([schoolId], map: "edu_cls_school_idx")
  @@map("educare_classrooms")
}

model EducareStudent {
  id             Int                  @id @default(autoincrement())
  ownerUserId    String               @map("owner_id") @db.VarChar(191)
  owner          User                 @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  trialSessionId String               @default("prod") @map("trial_session_id") @db.VarChar(36)
  classroomId    Int                  @map("classroom_id")
