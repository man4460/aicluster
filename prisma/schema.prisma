  pickupAddress   String         @map("pickup_address") @db.VarChar(500)
  dropoffAddress  String         @default("") @map("dropoff_address") @db.VarChar(500)
  serviceType     String         @default("") @map("service_type") @db.VarChar(160)
  packageId       Int?           @map("package_id")
  package         LaundryPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  packageName     String         @default("") @map("package_name") @db.VarChar(160)
  weightKg        Decimal        @default(0) @map("weight_kg") @db.Decimal(10, 3)
  itemCount       Int            @default(0) @map("item_count")
  finalPrice      Int            @default(0) @map("final_price")
  note            String         @default("") @map("note") @db.VarChar(1000)
  recordedByName  String         @default("") @map("recorded_by_name") @db.VarChar(160)
  status          String         @default("PENDING_PICKUP") @map("status") @db.VarChar(32)
