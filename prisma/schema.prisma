  /** ต่อขยาย API / แชร์สาธารณะในอนาคต */
  isPublic    Boolean  @default(false) @map("is_public")
  usageCount  Int      @default(0) @map("usage_count")
  status      PromptLibraryPromptStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  versions PromptLibraryVersion[]

  @@index([ownerUserId, status, updatedAt], map: "plp_owner_status_upd_idx")
  @@index([ownerUserId, categoryId], map: "plp_owner_cat_idx")
  @@index([ownerUserId, isFavorite], map: "plp_owner_fav_idx")
  @@map("prompt_library_prompts")
}

model PromptLibraryVersion {
  id         String              @id @default(cuid())
  promptId   String              @map("prompt_id") @db.VarChar(191)
  prompt     PromptLibraryPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  content    String              @db.Text
  versionNo  Int                 @map("version_no")
  changeNote String?             @map("change_note") @db.VarChar(280)
  createdById String             @map("created_by_id") @db.VarChar(191)
  createdBy  User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt  DateTime            @default(now()) @map("created_at")

  @@index([promptId, versionNo], map: "plv_prompt_ver_idx")
  @@map("prompt_library_versions")
}

