// ════════════════════════════════════════════════════════════════════
// Asset Management — บริหารทรัพย์สินองค์กร (กลุ่ม 1 Basic)
// ────────────────────────────────────────────────────────────────────
// Entity: Category, Department, Location, Supplier, Asset
//         Transaction (assign/borrow/return/transfer), Maintenance,
//         Disposal, Audit, Settings
// ════════════════════════════════════════════════════════════════════

enum AssetStatus {
  AVAILABLE
  IN_USE
  BORROWED
  IN_REPAIR
  DISPOSED
}

enum AssetCondition {
  GOOD
  FAIR
  POOR
  BROKEN
}

enum AssetTransactionType {
  ASSIGN
  BORROW
  RETURN
  TRANSFER
}

enum AssetTransactionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AssetMaintenanceType {
  PREVENTIVE
  CORRECTIVE
}

enum AssetMaintenanceStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AssetDisposalMethod {
  SALE
  DONATION
  WRITE_OFF
  RECYCLE
}

enum AssetDisposalStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum AssetAuditStatus {
  MATCH
  MISMATCH
  MISSING
}

model AssetCategory {
  id                  Int      @id @default(autoincrement())
  ownerUserId         String   @map("owner_id") @db.VarChar(191)
  owner               User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  trialSessionId      String   @default("prod") @map("trial_session_id") @db.VarChar(36)
  code                String   @db.VarChar(20)
  name                String   @db.VarChar(120)
  depreciationYears   Int      @default(5) @map("depreciation_years")
  description         String?  @db.Text
  isActive            Boolean  @default(true) @map("is_active")
  sortOrder           Int      @default(0) @map("sort_order")
  assets              Asset[]
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([ownerUserId, trialSessionId, code], map: "ast_cat_owner_trial_code_uidx")
  @@index([ownerUserId, trialSessionId, isActive], map: "ast_cat_owner_trial_active_idx")
  @@map("asset_categories")
}

model AssetDepartment {
  id                  Int      @id @default(autoincrement())
  ownerUserId         String   @map("owner_id") @db.VarChar(191)
  owner               User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
