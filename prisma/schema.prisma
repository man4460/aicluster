  owner              User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  trialSessionId     String   @default("prod") @map("trial_session_id") @db.VarChar(36)
  name               String   @default("") @db.VarChar(160)
  phone              String   @db.VarChar(32)
  teamName           String   @default("") @map("team_name") @db.VarChar(160)
  note               String   @default("") @db.VarChar(500)
  isActive           Boolean  @default(true) @map("is_active")
  /** ติ๊กเมื่อต้องการออกใบกำกับภาษี — เก็บชื่อ/เลขผู้เสียภาษี/ที่อยู่ไว้ใช้ตอนพิมพ์ */
  taxInvoiceEnabled  Boolean  @default(false) @map("tax_invoice_enabled")
  /** ชื่อในใบกำกับ (ว่าง = ใช้ชื่อลูกค้า) */
  billingName        String   @default("") @map("billing_name") @db.VarChar(160)
  taxId              String   @default("") @map("tax_id") @db.VarChar(30)
  taxAddress         String   @default("") @map("tax_address") @db.VarChar(1000)
  taxBranch          String   @default("") @map("tax_branch") @db.VarChar(120)
  /** รูปโปรไฟล์ลูกค้า (อัปโหลด / ถ่าย) */
  photoUrl           String   @default("") @map("photo_url") @db.VarChar(512)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([ownerUserId, trialSessionId, phone], map: "ft_cust_owner_trial_phone_uq")
  @@index([ownerUserId, trialSessionId], map: "ft_cust_owner_trial_idx")
  @@map("football_turf_customers")
}

model FootballTurfBooking {
  id                 Int               @id @default(autoincrement())
  ownerUserId        String            @map("owner_id") @db.VarChar(191)
  owner              User              @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  trialSessionId     String            @default("prod") @map("trial_session_id") @db.VarChar(36)
  courtId            Int               @map("court_id")
  court              FootballTurfCourt @relation(fields: [courtId], references: [id], onDelete: Restrict)
  bookingDate        DateTime          @map("booking_date") @db.Date
  startTime          String            @map("start_time") @db.VarChar(5)
  endTime            String            @map("end_time") @db.VarChar(5)
  customerName       String            @map("customer_name") @db.VarChar(160)
  customerPhone      String            @map("customer_phone") @db.VarChar(32)
  teamName           String            @default("") @map("team_name") @db.VarChar(160)
  playerCount        Int               @default(0) @map("player_count")
  source             String            @db.VarChar(20)
  status             String            @db.VarChar(20)
  listedPrice        Int               @default(0) @map("listed_price")
  finalPrice         Int               @default(0) @map("final_price")
  /** มัดจำ/ยอดที่ต้องชำระตอนจองจากพอร์ทัล (null = ไม่บังคับชำระตอนจอง) */
  depositAmountBaht  Int?              @map("deposit_amount_baht")
  /** ยอดที่ชำระแล้วสะสม (มัดจำ + ชำระเพิ่ม) */
  amountPaidBaht     Int               @default(0) @map("amount_paid_baht")
  /** คะแนนที่ให้แล้วจากบิลนี้ (กันให้ซ้ำ) */
  pointsEarned       Int               @default(0) @map("points_earned")
  pointsRedeemed     Int               @default(0) @map("points_redeemed")
  promotionSaleId    Int?              @map("promotion_sale_id")
  /** ลายเซ็นลูกค้าตอนใช้สิทธิ์โปรโมชัน / หักแพ็ก (path ใต้ /uploads/…) */
  signatureImageUrl  String?           @map("signature_image_url") @db.VarChar(512)
  note               String            @default("") @db.VarChar(500)
  paymentMethod      String            @default("UNPAID") @map("payment_method") @db.VarChar(20)
  /** UNPAID | PENDING_REVIEW | PARTIAL | PAID */
  paymentStatus      String            @default("UNPAID") @map("payment_status") @db.VarChar(20)
  paymentSlipDataUrl String?           @map("payment_slip_data_url") @db.VarChar(512)
  paymentReference   String            @default("") @map("payment_reference") @db.VarChar(120)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@index([ownerUserId, trialSessionId, bookingDate], map: "ft_book_owner_trial_date_idx")
  @@index([courtId])
  @@map("football_turf_bookings")
}

