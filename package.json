{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "mawell-deploy": "./bin/mawell-deploy"
  },
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0 --webpack",
    "dev:webpack": "next dev -p 3000 -H 0.0.0.0 --webpack",
    "dev:3001": "next dev -p 3001 -H 0.0.0.0 --webpack",
    "watch:prisma": "chokidar \"prisma/schema.prisma\" -c \"npm run db:generate\" -d 2000 --silent",
    "dev:watch": "concurrently -k -n next,prisma -c blue,magenta \"npm run dev\" \"npm run watch:prisma\"",
    "dev:3001:watch": "concurrently -k -n next,prisma -c blue,magenta \"npm run dev:3001\" \"npm run watch:prisma\"",
    "dev:clean": "npx --yes kill-port 3000 3001 3456 3457 && npx --yes rimraf@6 .next && next dev -p 3000 -H 0.0.0.0 --webpack",
    "dev:3001:clean": "npx --yes kill-port 3000 3001 3456 3457 && npx --yes rimraf@6 .next && next dev -p 3001 -H 0.0.0.0 --webpack",
    "build": "node scripts/prisma-generate-safe.cjs && next build --webpack",
    "build:pm2:prod": "npm run build && pm2 restart mawell-serve",
    "watch:build": "chokidar \"src/**/*\" \"public/**/*\" \"prisma/schema.prisma\" \"next.config.ts\" \"postcss.config.mjs\" \"package.json\" -c \"npm run build\" -d 12000 --silent",
    "watch:pm2:prod": "chokidar \"src/**/*\" \"public/**/*\" \"prisma/schema.prisma\" \"next.config.ts\" \"postcss.config.mjs\" \"package.json\" \"ecosystem.config.cjs\" -c \"npm run build:pm2:prod\" -d 12000 --silent",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "eslint",
    "verify:hf-vehicle-attachments": "tsx scripts/verify-home-finance-vehicle-attachments-db.ts",
    "check:chat-ai-db": "node --import tsx scripts/check-personal-ai-tables.ts",
    "seed": "tsx prisma/seed.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "node scripts/prisma-generate-safe.cjs",
    "postinstall": "node scripts/prisma-generate-safe.cjs",
    "pm2:dev": "pm2 start ecosystem.config.cjs --only mawell-dev",
    "pm2:dev:3001": "pm2 start ecosystem.config.cjs --only mawell-dev-3001",
    "pm2:prod": "pm2 start ecosystem.config.cjs --only mawell-serve",
    "pm2:prod:watch": "npm run pm2:prod && npm run watch:pm2:prod",
    "pm2:stop": "pm2 stop mawell-dev mawell-dev-3001 mawell-serve",
    "pm2:restart": "pm2 restart mawell-dev",
    "pm2:logs": "pm2 logs mawell-dev",
    "pm2:delete": "pm2 delete mawell-dev mawell-dev-3001 mawell-serve",
    "deploy": "bash scripts/deploy.sh",
    "link:cli": "npm link --ignore-scripts",
    "docker:build": "docker compose build app",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:db": "docker compose up -d db",
    "docker:db:wait": "docker compose up -d db --wait",
    "dev:docker-db": "docker compose up -d db --wait && npm run dev",
    "dev:docker-db:ps1": "powershell -ExecutionPolicy Bypass -File scripts/dev-docker-db.ps1",
    "dev:docker-db:sh": "bash scripts/dev-docker-db.sh",
    "docker:verify": "powershell -ExecutionPolicy Bypass -File scripts/docker-verify.ps1",
    "docker:verify:sh": "bash scripts/docker-verify.sh",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build app-dev",
    "docker:dev:detach": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build -d app-dev",
    "docker:dev:stop": "docker compose -f docker-compose.yml -f docker-compose.dev.yml stop app-dev",
    "docker:dev:logs": "docker compose -f docker-compose.yml -f docker-compose.dev.yml logs -f app-dev"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@react-oauth/google": "^0.13.5",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.2",
    "jspdf": "^4.2.1",
    "mqtt": "^5.15.1",
    "next": "16.2.1",
    "nodemailer": "^8.0.3",
    "openclaw-sdk": "^2026.3.19",
    "promptpay-qr": "^0.5.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "pm2": "^6.0.14",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": "1.32.0"
  }
}
