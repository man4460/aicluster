!/public/uploads/building-pos/.gitkeep
/public/uploads/home-finance/*
!/public/uploads/home-finance/.gitkeep
/public/uploads/attendance-roster/*
!/public/uploads/attendance-roster/.gitkeep
/public/uploads/car-wash/*
!/public/uploads/car-wash/.gitkeep
/public/uploads/car-wash-portal-slips/*
!/public/uploads/car-wash-portal-slips/.gitkeep
/public/uploads/car-wash-portal-signatures/*
!/public/uploads/car-wash-portal-signatures/.gitkeep
/public/uploads/barber-stylists/*
!/public/uploads/barber-stylists/.gitkeep
/public/uploads/barber-cash-receipts/*
!/public/uploads/barber-cash-receipts/.gitkeep
/public/uploads/barber-portal-slips/*
!/public/uploads/barber-portal-slips/.gitkeep
/public/uploads/module-cards/*
