# Legacy duplicate tree — แอปจริงอยู่ราก repo (มี node_modules/.next ของ copy เก่า)
/web/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
/src/generated/.prisma_stale_*

# iOS build artifacts — IPA ผูกกับ certificate ของเครื่อง build (อย่า commit)
/build/ios/
/ios/App/App.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/configuration/
/public/downloads/ios/MAWELL.ipa
/public/downloads/ios/manifest.plist

# local build / tooling artifacts (ไม่อัปโหลด)
/dist/
.wrangler/
.env copy

# DB backup local config (อาจมี SSH path / password ต้นทาง)
/scripts/backup-db.env
!/scripts/backup-db.env.example
